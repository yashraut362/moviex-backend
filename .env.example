TMDB_API_KEY=
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# Bookings (/api/bookings). Defaults to a local MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/moviex

# Semantic recommendations for POST /api/ask. If any of these is missing the
# route falls back to canned answers.
PINECONE_API_KEY=
PINECONE_INDEX=moviex
PINECONE_NAMESPACE=dev
OPENAI_API_KEY=
# Optional overrides
# OPENAI_CHAT_MODEL=gpt-5.4
# OPENAI_EMBED_MODEL=text-embedding-3-small
